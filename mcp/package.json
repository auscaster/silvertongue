{
	"name": "silvertongue",
	"version": "0.1.0",
	"description": "Famous writing voices for your agent: a stdio bridge to Silvertongue's hosted MCP server.",
	"mcpName": "com.auscaster/silvertongue",
	"license": "Apache-2.0",
	"type": "module",
	"bin": {
		"silvertongue": "dist/index.js"
	},
	"files": [
		"dist",
		"server.json",
		"README.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/auscaster/silvertongue.git",
		"directory": "mcp"
	},
	"homepage": "https://auscaster.com/silvertongue",
	"bugs": {
		"url": "https://github.com/auscaster/silvertongue/issues"
	},
	"keywords": [
		"silvertongue",
		"mcp",
		"model-context-protocol",
		"mcp-server",
		"writing",
		"voice",
		"style",
		"famous-voices",
		"ai-agents"
	],
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.json",
		"test": "node --test test/*.test.mjs",
		"verify": "npm run build && npm test"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"dependencies": {
		"@modelcontextprotocol/client": "2.4.0",
		"@modelcontextprotocol/server": "2.1.0"
	},
	"devDependencies": {
		"@types/node": "24.19.0",
		"typescript": "7.0.2"
	}
}
